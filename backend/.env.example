# ==============================================================================
# Kalyan Setu Backend Environment Configuration (Render & Local)
# ==============================================================================

# Database: Supabase PostgreSQL Connection Pooler URL (Transaction Mode, Port 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Secret for Auth Token Signing
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# AI & LLM Services
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# HuggingFace Token (for BLIP Vision & Whisper Audio fallback)
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_token

# Sarvam AI STT (for Indian Voice Grievance Redressal)
SARVAM_API_KEY=sk_your_sarvam_api_key

# CORS Frontend Allowed Origins (Comma-separated for multiple domains)
# In production on Render, set this to your Vercel URL, e.g.:
# FRONTEND_URL=https://kalyan-setu.vercel.app
FRONTEND_URL=http://localhost:5173
